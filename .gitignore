# ---- HMOS .gitignore ----

# Signing private keys NEVER go into the repo, even a public one.
# Public material (.crt/.der/.esl) under keys/ is kept.
keys/**/*.key

# Rebuildable Python local packages: drop caches and the bulk setuptools test tree;
# the runtime modules (pyfatfs/fs/six/appdirs) are still vendored under tools/pylib.
tools/pylib/__pycache__/
tools/pylib/setuptools/tests/
tools/pylib/pkg_resources/tests/

# Build / staging intermediates (regenerated by build_hmos.bat).
build/
iso_root/
hmos.iso

# QEMU run-time artifacts: serial/debug logs, raw frame captures.
qemu_test/*.log
qemu_test/shots/*.ppm
qemu_test/fw/vars-run-*.fd

# Editor / OS noise
Thumbs.db
desktop.ini
*.tmp
*.bak
