# ---- HMOS .gitignore ----

# Signing private keys NEVER go into the repo, even a public one.
# Public material (.crt/.der/.esl) under keys/ is kept.
keys/**/*.key
# Signed authenticated-variable blobs (.auth) carry a private-key signature;
# keep them local even though they embed no private key.
keys/auth/

# Rebuildable Python local packages: drop caches and the bulk setuptools test tree;
# the runtime modules (pyfatfs/fs/six/appdirs) are still vendored under tools/pylib.
tools/pylib/__pycache__/
tools/pylib/setuptools/tests/
tools/pylib/pkg_resources/tests/
# Temporary crypto toolchain pulled in for offline .auth verification only; not part
# of the vendored runtime. Reinstall with: pip install --target tools\pylib cryptography
tools/pylib/cryptography/
tools/pylib/cryptography-*.dist-info/
tools/pylib/cffi/
tools/pylib/cffi-*.dist-info/
tools/pylib/pycparser/
tools/pylib/pycparser-*.dist-info/
tools/pylib/_cffi_backend.*.pyd
tools/pylib/bin/

# Build / staging intermediates (regenerated by build_hmos.bat).
build/
iso_root/
hmos.iso

# QEMU run-time artifacts: serial/debug logs, raw frame captures.
qemu_test/*.log
qemu_test/shots/*.ppm
qemu_test/fw/vars-run-*.fd
# Built 64MiB ESP disk image (regenerated on a Linux host with pyfatfs).
qemu_test/fw/esp.img
qemu_test/fw/esp.img.gz

# Editor / OS noise
Thumbs.db
desktop.ini
*.tmp
*.bak
