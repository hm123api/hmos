# ---- HMOS .gitignore ----

# Signing private keys NEVER go into the repo. Public material (.crt/.der/.esl)
# under keys/ is kept.
keys/**/*.key

# Third-party toolchain, firmware and vendored binaries are not committed.
# Re-download per the versions listed in README.md.
tools/

# Build / staging intermediates (regenerated by build_hmos.bat).
build/
iso_root/
hmos.iso

# Signed ESP staging tree and disk images (regenerated from sources + keys).
esp_material/
qemu_test/fw/*.img
qemu_test/fw/*.img.gz
qemu_test/fw/*.fd

# QEMU run-time artifacts: serial/debug logs, raw frame captures.
qemu_test/*.log
qemu_test/shots/*.ppm

# Editor / OS noise
Thumbs.db
desktop.ini
*.tmp
*.bak
